@page "/"

<PageTitle>Music Practice Scheduler</PageTitle>

<h1>Music Practice Scheduler</h1>

<p>Welcome! This app helps you organize and track your music practice sessions.</p>

<div style="margin: 20px 0;">
    <h3>What you can do:</h3>
    <ul>
        <li>Manage your songs and organize them by genre</li>
        <li>Schedule practice sessions and track them</li>
        <li>See your recently practiced songs</li>
    </ul>
</div>

<div style="margin: 20px 0;">
    <h3>Get Started:</h3>
    <NavLink href="songs" class="btn btn-primary">Go to Songs</NavLink>
    <NavLink href="schedule" class="btn btn-primary" style="margin-left: 10px;">Go to Schedule</NavLink>
    <button @onclick="LoadDefaultSongs" class="btn btn-secondary" style="margin-left: 10px;">Load Sample Data</button>
    <p>Total Songs: <strong>@totalSongs</strong></p>
    <p>Upcoming Sessions: <strong>@upcomingSessions</strong></p>
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p style="color: green; font-weight: bold;">@message</p>
    }
</div>

@code {
    private int totalSongs = 0;
    private int upcomingSessions = 0;
    private string message = "";

    // Scheduler instance
    private MusicScheduler scheduler = new MusicScheduler();

    protected override void OnInitialized()
    {
        // Initialize with default values
        UpdateStats();
    }

    // Load 20 default sample songs
    private void LoadDefaultSongs()
    {
        try
        {
            scheduler.LoadDefaultSongs();
            message = "Loaded 20 sample songs successfully!";
            UpdateStats();
        }
        catch (Exception ex)
        {
            message = "Error loading sample songs: " + ex.Message;
        }
    }

    // Update statistics display
    private void UpdateStats()
    {
        totalSongs = scheduler.GetTotalSongs();
        upcomingSessions = scheduler.GetUpcomingSessions().Count;
    }
}
